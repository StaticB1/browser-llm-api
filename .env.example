# Copy to .env and edit. The real environment (a shell export or a systemd
# drop-in) wins over this file. Every setting is optional; the values shown
# are the defaults. docs/configuration.md explains each one.

# Providers and models
# DEFAULT_PROVIDER=chatgpt-browser
# IMAGE_PROVIDERS=chatgpt-browser,gemini-browser
# CHATGPT_MODEL=GPT-6
# CHATGPT_EFFORT=high
# CHATGPT_IMAGE_TOOL=1
# CHATGPT_IMAGE_RESERVE=0
# CHATGPT_READ_MODEL=1

# Server
# BROWSER_LLM_HOST=127.0.0.1
# BROWSER_LLM_PORT=8081
# BROWSER_LLM_API_KEY=
# BROWSER_LLM_IMAGE_DIR=~/Pictures/browser-llm
# BROWSER_LLM_PUBLIC_URL=http://localhost:8081
# BROWSER_LLM_EPHEMERAL=0
# BROWSER_LLM_PREWARM=1
# BROWSER_RECYCLE_AFTER_IMAGES=8
# MAX_ATTACHMENTS=6
# MAX_ATTACHMENT_MB=20
# ALLOW_REMOTE_FILE_PATHS=

# Clients (CLI, asset and design tools, MCP server, desktop app)
# BROWSER_LLM_API=http://localhost:8081
# BROWSER_LLM_MODEL=chatgpt-browser
# BROWSER_LLM_IMAGE_MODEL=chatgpt-browser
# BROWSER_LLM_MCP_TIMEOUT=440

# Watchdog alerts
# BLM_ALERT_DIR=
# BLM_ALERT_CMD=
